# Copy to .env and fill in secrets. Never commit the real .env.

# --- Replay / fixture mode (default demo path; requires no external services) ---
REPLAY_MODE=true
REPLAY_LLM=true
FIXTURE_NAME=synthetic_v0

# --- Responsible-gaming / compliance chokepoint (DESIGN.md §12) ---
GATING_ENABLED=false

# --- Feature guards ---
ODDS_API_ENABLED=false

# --- Service connections (defaults match docker/docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hailmary
POSTGRES_PASSWORD=hailmary
POSTGRES_DB=hailmary

ELASTICSEARCH_HOST=http://localhost:9200
QDRANT_HOST=localhost
QDRANT_PORT=6333
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Secrets (local only; leave blank until you have them — see docs/PLAN.md) ---
# The live LLM/embedding provider is Gemini (docs/AMENDMENTS.md A1).
GEMINI_API_KEY=
# Kept because clients/llm.py still routes an "anthropic/"-qualified model id here;
# unset unless you deliberately point HAIKU_MODEL/SONNET_MODEL back at Anthropic.
ANTHROPIC_API_KEY=
CFBD_API_KEY=
ODDS_API_KEY=

# --- Prompt/model versioning ---
# Bare model ids below are cassette keys for replay. For LIVE calls, set
# provider-qualified ids, e.g.:
#   HAIKU_MODEL=google/gemini-2.5-flash
#   SONNET_MODEL=google/gemini-2.5-pro
#   VOYAGE_MODEL=gemini-embedding-001
PROMPT_VERSION=v1
HAIKU_MODEL=claude-haiku-4-5
SONNET_MODEL=claude-sonnet-4-6
VOYAGE_MODEL=voyage-3
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Nested tunables (see src/hailmary/config.py for full list + defaults) ---
# ELO__K=20.0
# ELO__HOME_FIELD=65.0
# ELO__MOV_MULTIPLIER=1.0
# EDGE__LOGISTIC_SCALE=400.0
# EDGE__EV_VALUE_THRESHOLD_PCT=3.0
# EDGE__EV_NO_VALUE_THRESHOLD_PCT=-3.0
# CACHE__COSINE_THRESHOLD=0.92
# TTL__ODDS_MINUTES_LIVE=5
# TTL__ODDS_MINUTES_REPLAY=60
# TTL__INJURIES_MINUTES=30
# TTL__WEATHER_HOURS=3
# TTL__RECAPS_DAYS=7
# RETRIEVAL__K_STATS=20
# RETRIEVAL__K_SEMANTIC=10
# RETRIEVAL__K_LIVE=10
# RETRIEVAL__TIMEOUT_SECONDS_PER_SOURCE=2.5
# RETRIEVAL__CONTEXT_BUDGET_CHUNKS=40
# COST__PER_QUERY_USD_CAP=0.15
# COST__PER_QUERY_USD_ALERT=0.10
# COST__PER_DAY_USD_CAP=2.0
# COST__PER_DAY_USD_ALERT_PCT=0.80
